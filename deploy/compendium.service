[Unit]
Description=Vixinman Household Compendium (gunicorn)
After=network.target

[Service]
Type=simple
User=compendium
Group=compendium
WorkingDirectory=/opt/compendium
EnvironmentFile=/opt/compendium/.env
# adduser --system (no --home given) sets this account's home directory
# to the literal, nonexistent path "/nonexistent" -- gunicorn tries to
# use $HOME as scratch space for an internal control socket and fails
# with "Read-only file system: '/nonexistent'" without this override.
Environment=HOME=/opt/compendium
# Piece 80: --timeout 180 (gunicorn's default is 30s) -- a long AI Assistant
# reply, especially one using tool-calling (up to a few round-trips to
# Claude), could take longer than 30s and get its worker killed mid-request
# before this fix.
ExecStart=/opt/compendium/venv/bin/gunicorn --workers 2 --timeout 180 --bind 127.0.0.1:8000 app:app
Restart=on-failure
RestartSec=5

# Basic hardening -- the service only needs to read/write its own
# working directory (the SQLite DB and secret_key.txt live there).
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/compendium

[Install]
WantedBy=multi-user.target
